<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.flow-mcp.chrome</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9222</string>
    <string>--user-data-dir=__PROFILE__</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
    <string>https://flow.google.com</string>
  </array>

  <!-- Start at login. Deliberately no KeepAlive: if you quit this Chrome
       you meant to, and launchd should not drag it back. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/chrome.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/chrome.err.log</string>
</dict>
</plist>
